

// Given an array of integers, print the array of numbers whose 4th bit is set (1) in 
// ascending order.
// iP: 

// [12, 7, 31, 16, 2, 23, 8, 32, 45, 9, 15, 18, 10]

#include <stdio.h>

void swap(int* a,int*b)
{
    int temp = *a;
     *a= *b;
    *b = *a;
}


int setBit(int a)
{
    int b = (a>>3) & 1;
    return b;
}

int sort(int *arr, int n)
{
    for(int i=0;i<n;i++)
    {
        for(int j=i+1;j<n-1;j++)
        if(arr[i]>arr[j])
        {
            swap(&arr[i] ,&arr[j]);
        }
    }
}


int main()
{
    int arr[13] = {12, 7, 31, 16, 2, 23, 8, 32, 45, 9, 15, 18, 10};
    int ans[13]={0};
    int j=0;
    
    sort(arr,13);
    
    for(int i=0;i<13;i++)
    {
       if(setBit(arr[i]))
       {
           ans[j++]=arr[i];
       }
    }
    
    
    for(int i=0;i<13;i++)
    {
        printf("%d\ ",ans[i]);
    }
}
